from snakemake.utils import min_version

##### set minimum snakemake version #####
min_version("8.4.1")


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/delivery.smk"


rule all:
    input:
        expand(dst_path("output/{seqid}/.delivery.done"), seqid=analytes.seqid),


rule filter_infoscore:
    input:
        previous_path("output/{seqid}/{seqid}.gwaslab.tsv.bgz"),
    output:
        ws_path("output/{seqid}/{seqid}.gwaslab.tsv.gz"),
    conda:
        "envs/filter_infoscore.yaml"
    params:
        snpid2filter=config.get("snpid2filter"),
    resources:
        runtime=lambda wc, attempt: attempt * 30,
    shell:
        "python workflow/scripts/filter_infoscore.py "
        "-i {input} "
        "-o {output} "
        "-f {params.snpid2filter}"


rule bgzip_tabix:
    input:
        ws_path("output/{seqid}/{seqid}.gwaslab.tsv.gz"),
    output:
        ws_path("output/{seqid}/{seqid}.gwaslab.tsv.bgz"),
        ws_path("output/{seqid}/{seqid}.gwaslab.tsv.bgz.tbi"),
    conda:
        "envs/bgzip_tabix.yaml"
    resources:
        runtime=lambda wc, attempt: attempt * 60,
    shell:
        "workflow/scripts/bgzip_tabix.sh {input} {threads}"
